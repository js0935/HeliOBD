    <!-- Diagnosis knowledge base (rule titles/advice) -->
    <string name="diag_rule_ignition_title">Ignition system fault</string>
    <string name="diag_rule_ignition_advice">Check spark plug gap and carbon, ignition coil and HT leads first; single-cylinder misfire usually comes with vibration and weak acceleration.</string>
    <string name="diag_rule_fuel_title">Insufficient fuel supply</string>
    <string name="diag_rule_fuel_advice">Check injectors for blockage, fuel pump pressure and fuel filter; a dirty air filter causes rich mixture and higher fuel use.</string>
    <string name="diag_rule_cooling_title">Cooling system fault</string>
    <string name="diag_rule_cooling_advice">Stop and cool down immediately; check coolant level, water pump and fan. Riding while overheating can burn the head gasket.</string>
    <string name="diag_rule_intake_title">Intake system fault</string>
    <string name="diag_rule_intake_advice">Check intake hoses for cracks/leaks, air filter and throttle body carbon; clean and re-learn idle afterwards.</string>
    <string name="diag_rule_emission_title">Emission system fault</string>
    <string name="diag_rule_emission_advice">Check O2 sensor and catalytic converter; an aging O2 sensor raises fuel use and emissions — check it first when exhaust smells odd.</string>
    <string name="diag_rule_battery_title">Battery / charging system fault</string>
    <string name="diag_rule_battery_advice">Measure battery voltage at idle (normal 13.5–14.5V); a faulty rectifier or stator causes hard starts and electrical instability.</string>
    <string name="diag_rule_drivetrain_title">Drivetrain fault</string>
    <string name="diag_rule_drivetrain_advice">Check chain tension and lube, and clutch slip (RPM rising without acceleration); a loose chain causes noise and skipping.</string>
    <string name="diag_rule_brake_title">Brake system fault</string>
    <string name="diag_rule_brake_advice">Check pad wear and disc warping; noise often comes from wear indicators or debris in the disc — inspect immediately.</string>

